# Option A: Gemini API key (quickest)
GOOGLE_API_KEY=your-key-here
# Option B: Vertex AI on Google Cloud (uses gcloud application-default credentials)
USE_VERTEX=false
GCP_PROJECT=your-gcp-project
GCP_LOCATION=us-central1
MODEL_NAME=gemini-2.5-flash
# Run without any cloud credentials using canned responses
DEMO_MODE=false
FRAME_INTERVAL_SEC=3
MAX_FRAMES=12
API_URL=http://localhost:8000
